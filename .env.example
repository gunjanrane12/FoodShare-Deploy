# FoodShare — Environment Variables
# Copy this file to .env and fill in your values.
# If not using .env, the defaults below work for a fresh local MySQL install.

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Session (change this to any random string in production)
SESSION_SECRET=foodshare-change-me-in-production

# MySQL — local machine defaults
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=foodshare
